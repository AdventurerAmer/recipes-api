# Env
RECIPES.ENV=local

# Infra
RECIPES.INFRA.MAIN_DATABASE.HOST=localhost
RECIPES.INFRA.MAIN_DATABASE.PORT=27017
RECIPES.INFRA.MAIN_DATABASE.USERNAME=admin
RECIPES.INFRA.MAIN_DATABASE.PASSWORD=admin
RECIPES.INFRA.MAIN_DATABASE.NAME=recipes

RECIPES.INFRA.MAIN_CACHE.HOST=localhost
RECIPES.INFRA.MAIN_CACHE.PORT=6379
RECIPES.INFRA.MAIN_CACHE.USERNAME=admin
RECIPES.INFRA.MAIN_CACHE.PASSWORD=admin
RECIPES.INFRA.MAIN_CACHE.DATABASE=0

RECIPES.INFRA.SESSIONS_CACHE.HOST=localhost
RECIPES.INFRA.SESSIONS_CACHE.PORT=6380
RECIPES.INFRA.SESSIONS_CACHE.USERNAME=admin
RECIPES.INFRA.SESSIONS_CACHE.PASSWORD=admin
RECIPES.INFRA.SESSIONS_CACHE.DATABASE=0

RECIPES.INFRA.MAIN_OBJECT_STORAGE.HOST=localhost
RECIPES.INFRA.MAIN_OBJECT_STORAGE.PORT=9000
RECIPES.INFRA.MAIN_OBJECT_STORAGE.USERNAME=admin
RECIPES.INFRA.MAIN_OBJECT_STORAGE.PASSWORD=admin

RECIPES.INFRA.MAIN_TEXT_SEARCH.HOST=localhost
RECIPES.INFRA.MAIN_TEXT_SEARCH.PORT=9200

# Server
# RECIPES.SERVER_SESSIONS_SECRET='xnx6D7fCxR47XqHGrnkqIBDjHIoz1csJ'
# RECIPES.SERVER_SESSIONS_MAX_IDEL_CONNS=10
# RECIPES.SERVER_SESSIONS_NAME='recipes'
