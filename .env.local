# Tracing
RECIPES.OBSERVABILITY.TRACING.ENABLED=true
RECIPES.OBSERVABILITY.TRACING.ENDPOINT='localhost:4314'
RECIPES.OBSERVABILITY.TRACING.SAMPLE_RATE=1.0

# Metrics
RECIPES.OBSERVABILITY.METRICS.ENABLED=true
RECIPES.OBSERVABILITY.METRICS.ENDPOINT='localhost:4317'
RECIPES.OBSERVABILITY.METRICS.RUNTIME=true
RECIPES.OBSERVABILITY.METRICS.REQUESTS=true